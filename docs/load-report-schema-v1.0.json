{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traceharbor.local/schemas/load-report-v1.0.json",
  "title": "TraceHarbor live load report v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "load_report_schema_version",
    "target",
    "scenario",
    "requested",
    "concurrency",
    "succeeded",
    "failed",
    "error_rate",
    "status_counts",
    "latency",
    "thresholds",
    "passed"
  ],
  "properties": {
    "load_report_schema_version": {"const": "1.0"},
    "target": {"type": "string", "format": "uri"},
    "scenario": {
      "enum": ["healthy", "payment_latency", "payment_failure", "inventory_failure"]
    },
    "requested": {"type": "integer", "minimum": 1},
    "concurrency": {"type": "integer", "minimum": 1},
    "succeeded": {"type": "integer", "minimum": 0},
    "failed": {"type": "integer", "minimum": 0},
    "error_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "status_counts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "count"],
        "properties": {
          "status": {"type": "string", "pattern": "^(?:[1-5][0-9]{2}|INVALID_RESPONSE|TRANSPORT_ERROR)$"},
          "count": {"type": "integer", "minimum": 1}
        }
      }
    },
    "latency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_ms", "median_ms", "p95_ms", "maximum_ms"],
      "properties": {
        "minimum_ms": {"type": "number", "minimum": 0},
        "median_ms": {"type": "number", "minimum": 0},
        "p95_ms": {"type": "number", "minimum": 0},
        "maximum_ms": {"type": "number", "minimum": 0}
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_error_rate", "maximum_p95_ms"],
      "properties": {
        "maximum_error_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "maximum_p95_ms": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "passed": {"type": "boolean"}
  }
}
